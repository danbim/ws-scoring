{
  "name": "ws-scoring",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "bun run --hot server.ts",
    "dev:app": "vite",
    "test": "bun test --shuffle __tests__/api __tests__/domain __tests__/integration",
    "test:components": "vitest",
    "test:components:run": "vitest run",
    "test:all": "bun test --shuffle __tests__/api __tests__/domain __tests__/integration && vitest run",
    "test:e2e": "cd e2e && BASE_URL=http://localhost:${VITE_DEV_PORT:-5173} API_URL=http://localhost:${PORT:-3000} npx playwright test",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --error-on-warnings --write .",
    "format": "biome format --write .",
    "check": "biome check",
    "check:fix": "biome check --write .",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "typecheck": "tsc --noEmit",
    "build:app": "vite build",
    "build:docker": "docker build .",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:up": "docker-compose up -d",
    "docker:up:build": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bun run scripts/db/reset.ts",
    "db:seed": "bun run scripts/db/seed.ts",
    "db:seed:dry-run": "bun run scripts/db/seed.ts --dry-run",
    "db:seed:users": "bun run scripts/db/seed-users.ts",
    "create-heat": "bun run scripts/create-heat.ts",
    "submit-jump-score": "bun run scripts/submit-jump-score.ts",
    "submit-wave-score": "bun run scripts/submit-wave-score.ts",
    "users:create": "bun run scripts/users/create-user.ts",
    "users:list": "bun run scripts/users/list-users.ts",
    "users:update": "bun run scripts/users/update-user.ts",
    "users:delete": "bun run scripts/users/delete-user.ts",
    "users:change-password": "bun run scripts/users/change-password.ts",
    "seasons:create": "bun run scripts/seasons/create-season.ts",
    "seasons:list": "bun run scripts/seasons/list-seasons.ts",
    "seasons:update": "bun run scripts/seasons/update-season.ts",
    "seasons:delete": "bun run scripts/seasons/delete-season.ts",
    "contests:create": "bun run scripts/contests/create-contest.ts",
    "contests:list": "bun run scripts/contests/list-contests.ts",
    "contests:update": "bun run scripts/contests/update-contest.ts",
    "contests:delete": "bun run scripts/contests/delete-contest.ts",
    "divisions:create": "bun run scripts/divisions/create-division.ts",
    "divisions:list": "bun run scripts/divisions/list-divisions.ts",
    "divisions:update": "bun run scripts/divisions/update-division.ts",
    "divisions:delete": "bun run scripts/divisions/delete-division.ts",
    "brackets:create": "bun run scripts/brackets/create-bracket.ts",
    "brackets:list": "bun run scripts/brackets/list-brackets.ts",
    "brackets:update": "bun run scripts/brackets/update-bracket.ts",
    "brackets:delete": "bun run scripts/brackets/delete-bracket.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.29.1",
    "happy-dom": "^20.1.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "vite-plugin-solid": "^2.10.1",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@kobalte/core": "^0.13.11",
    "@orpc/client": "^1.13.4",
    "@orpc/openapi": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/solid-query": "^1.13.4",
    "@orpc/zod": "^1.13.4",
    "@solidjs/router": "^0.11.1",
    "@tanstack/solid-query": "^5.90.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.37.0",
    "neverthrow": "^8.2.0",
    "pg": "^8.16.3",
    "solid-js": "^1.9.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "zod": "^4.2.1"
  }
}
